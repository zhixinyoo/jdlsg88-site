---
import { siteConfig } from '../config/site';

interface Props {
  title: string;
  description?: string;
  canonical?: string;
  ogImage?: string;
  schema?: object;
}

const {
  title,
  description = siteConfig.seo.description,
  canonical = Astro.url.href,
  ogImage = siteConfig.seo.ogImage,
  schema,
} = Astro.props;

// Avoid "X - Brand | Brand" duplication when the page title already carries the brand name
// (every per-page title in this build is passed pre-suffixed, e.g. "Home - JDL688 Singapore").
const fullTitle = title.includes(siteConfig.brand) ? title : `${title} | ${siteConfig.brand}`;
const ogImageAbsolute = ogImage.startsWith('http')
  ? ogImage
  : `https://${siteConfig.domain}${ogImage}`;
---

<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  <meta name="keywords" content={siteConfig.seo.keywords} />
  <link rel="canonical" href={canonical} />

  <!-- Open Graph -->
  <meta property="og:type" content="website" />
  <meta property="og:url" content={canonical} />
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={ogImageAbsolute} />
  <meta property="og:site_name" content={siteConfig.brand} />

  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={fullTitle} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImageAbsolute} />

  <!-- Favicon -->
  <link rel="icon" href={siteConfig.images.favicon} />

  <!-- WebSite Schema (every page) -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "WebSite",
    "name": siteConfig.brand,
    "url": `https://${siteConfig.domain}`,
    "potentialAction": {
      "@type": "SearchAction",
      "target": `https://${siteConfig.domain}/blog?q={search_term_string}`,
      "query-input": "required name=search_term_string"
    }
  })} />

  <!-- Page-specific schema (optional) -->
  {schema && <script type="application/ld+json" set:html={JSON.stringify(schema)} />}

  <!-- Google Fonts — Manrope, brand font per competitor-reference.json -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&display=swap" />

  <style is:global define:vars={{
    bg:      siteConfig.colors.bg,
    bg2:     siteConfig.colors.bg2,
    primary: siteConfig.colors.primary,
    accent:  siteConfig.colors.accent,
    text:    siteConfig.colors.text,
    font:    siteConfig.colors.font,
    radius:  siteConfig.colors.radius,
  }}>
    :root {
      --bg:      var(--astro-defined-bg);
      --bg2:     var(--astro-defined-bg2);
      --primary: var(--astro-defined-primary);
      --accent:  var(--astro-defined-accent);
      --text:    var(--astro-defined-text);
      --font:    var(--astro-defined-font);
      --radius:  var(--astro-defined-radius);
      --gap:     12px;

      /* Design-system extensions layered on top of the brand tokens above */
      --accent-2:      #ffe27a;
      --accent-dim:    #b89323;
      --navy-deep:     #060b26;
      --line:          rgba(245, 208, 67, 0.14);
      --shadow-gold:   0 0 0 1px rgba(245, 208, 67, .18), 0 8px 24px rgba(0, 0, 0, .55);
      --shadow-lift:   0 14px 34px rgba(0, 0, 0, .5);
      --ease-out:      cubic-bezier(.16, 1, .3, 1);
    }

    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    html { scroll-behavior: smooth; }

    body {
      background:
        radial-gradient(ellipse 900px 560px at 12% -8%, rgba(9, 23, 78, .65), transparent 62%),
        radial-gradient(ellipse 720px 520px at 104% 12%, rgba(245, 208, 67, .07), transparent 58%),
        radial-gradient(ellipse 640px 480px at 50% 100%, rgba(9, 23, 78, .35), transparent 60%),
        var(--bg);
      background-attachment: fixed;
      color: var(--text);
      font-family: var(--font), 'Noto Sans', sans-serif;
      min-height: 100vh;
      padding-bottom: 64px;
      -webkit-font-smoothing: antialiased;
    }

    a { text-decoration: none; color: inherit; }
    img { max-width: 100%; height: auto; }

    h1, h2, h3, h4 { font-family: var(--font), 'Noto Sans', sans-serif; letter-spacing: -0.01em; }

    ::selection { background: var(--accent); color: #000; }

    /* Focus visibility — accessibility floor */
    a:focus-visible, button:focus-visible, input:focus-visible {
      outline: 2px solid var(--accent);
      outline-offset: 2px;
    }

    @media (prefers-reduced-motion: reduce) {
      *, *::before, *::after { animation-duration: .001ms !important; animation-iteration-count: 1 !important; transition-duration: .001ms !important; scroll-behavior: auto !important; }
    }

    /* ---------- Sidebar ---------- */
    .sidebar-overlay {
      display: none; position: fixed; inset: 0; background: rgba(0,0,0,.6); z-index: 200;
      backdrop-filter: blur(2px);
    }
    .sidebar-overlay.open { display: block; }
    .sidebar {
      position: fixed; top: 0; left: -280px; width: 260px; height: 100vh;
      background: linear-gradient(180deg, var(--bg2), var(--navy-deep));
      z-index: 300; transition: left .32s var(--ease-out);
      display: flex; flex-direction: column; padding: 0;
      box-shadow: var(--shadow-lift);
      border-right: 1px solid var(--line);
    }
    .sidebar.open { left: 0; }
    .sidebar-header {
      display: flex; align-items: center; justify-content: space-between; padding: 12px 14px;
      border-bottom: 1px solid var(--accent);
    }
    .sidebar-header img { height: 36px; width: auto; }
    .sidebar-close { background: none; border: none; color: var(--text); font-size: 1.4rem; cursor: pointer; }
    .sidebar-nav { flex: 1; padding: 12px 0; overflow-y: auto; }
    .sidebar-nav a {
      display: flex; align-items: center; gap: 10px; padding: 11px 18px;
      font-size: .9rem; font-weight: 600; color: var(--text);
      border-bottom: 1px solid rgba(255,255,255,.05);
      transition: background .15s, padding-left .15s;
    }
    .sidebar-nav a:hover { background: rgba(245, 208, 67, .07); padding-left: 22px; }
    .sidebar-dropdown-toggle {
      display: flex; align-items: center; gap: 10px; width: 100%; padding: 11px 18px;
      font-size: .9rem; font-weight: 600; color: var(--text); background: none; border: none;
      border-bottom: 1px solid rgba(255,255,255,.05); cursor: pointer; font-family: inherit; text-align: left;
      transition: background .15s, padding-left .15s;
    }
    .sidebar-dropdown-toggle:hover { background: rgba(245, 208, 67, .07); padding-left: 22px; }
    .dropdown-chevron { margin-left: auto; font-size: .75rem; transition: transform .2s; }
    .sidebar-dropdown-toggle.open .dropdown-chevron { transform: rotate(180deg); color: var(--accent); }
    .sidebar-submenu {
      max-height: 0; overflow: hidden; transition: max-height .25s ease;
      background: rgba(0, 0, 0, .18);
    }
    .sidebar-submenu.open { max-height: 260px; }
    .sidebar-submenu a {
      display: block; padding: 10px 18px 10px 44px; font-size: .82rem; font-weight: 500;
      color: #cfcfcf; border-bottom: 1px solid rgba(255,255,255,.04);
    }
    .sidebar-submenu a:hover { background: rgba(245, 208, 67, .07); color: var(--accent); }
    .sidebar-cta { display: flex; gap: 8px; padding: 14px; border-top: 1px solid var(--accent); }
    .btn-login-side, .btn-register-side {
      flex: 1; padding: 10px 0; text-align: center; font-weight: 700; border-radius: var(--radius);
      transition: opacity .2s, transform .15s;
    }
    .btn-login-side { background: transparent; border: 1px solid var(--accent); color: var(--accent); }
    .btn-register-side { background: var(--accent); color: #000; }
    .btn-login-side:hover, .btn-register-side:hover { opacity: .88; transform: translateY(-1px); }

    /* ---------- Header ---------- */
    .site-header {
      position: sticky; top: 0; z-index: 100;
      display: grid; grid-template-columns: 1fr auto 1fr; align-items: center;
      padding: 4px 10px;
      background: linear-gradient(135deg, var(--bg2), var(--navy-deep));
      border-bottom: 3px solid var(--accent);
      box-shadow: 0 2px 18px rgba(0,0,0,.45);
    }
    .header-hamburger {
      background: none; border: none; color: var(--accent); font-size: 1.4rem; cursor: pointer; justify-self: start;
      transition: transform .15s;
    }
    .header-hamburger:active { transform: scale(.9); }
    .header-logo-wrap { text-align: center; }
    .header-logo-wrap img { height: 40px; width: auto; filter: drop-shadow(0 2px 8px rgba(0,0,0,.5)); }
    .header-btns { display: flex; gap: 6px; justify-content: flex-end; align-items: center; }
    .btn-login-hdr {
      padding: 7px 14px; font-size: .8rem; font-weight: 700; border-radius: var(--radius);
      background: transparent; border: 1.5px solid var(--accent); color: var(--accent);
      transition: background .15s, color .15s;
    }
    .btn-login-hdr:hover { background: rgba(245, 208, 67, .1); }
    .btn-register-hdr {
      padding: 7px 14px; font-size: .8rem; font-weight: 700; border-radius: var(--radius);
      background: var(--accent); color: #000;
      box-shadow: 0 3px 10px rgba(0,0,0,.35);
      transition: transform .15s, box-shadow .15s;
    }
    .btn-register-hdr:hover { transform: translateY(-1px); box-shadow: 0 5px 14px rgba(0,0,0,.45); }

    .announcement-bar {
      overflow: hidden; white-space: nowrap; padding: 6px 0; font-size: .8rem;
      background: linear-gradient(90deg, var(--navy-deep), #091828 60%, var(--navy-deep));
      border-bottom: 1px solid #1c3a6e; color: var(--accent);
      position: relative;
    }
    .announcement-bar::before {
      content: '●'; position: absolute; left: 10px; top: 50%; transform: translateY(-50%);
      color: #ff4d4d; font-size: .6rem; animation: pulse-dot 1.6s ease-in-out infinite;
      display: none;
    }
    @keyframes pulse-dot { 0%, 100% { opacity: 1; } 50% { opacity: .25; } }
    .marquee-inner { display: inline-block; }

    /* ---------- Footer nav ---------- */
    .footer-nav {
      position: fixed; bottom: 0; left: 0; right: 0; display: flex; z-index: 100;
      background: linear-gradient(180deg, #0b1a30, var(--navy-deep));
      border-top: 1px solid var(--accent);
      box-shadow: 0 -4px 18px rgba(0,0,0,.45);
    }
    .footer-nav a {
      flex: 1; display: flex; flex-direction: column; align-items: center; justify-content: center;
      padding: 7px 4px; font-size: .65rem; font-weight: 600; color: #aaa; gap: 2px;
      transition: color .15s, transform .15s;
    }
    .footer-nav a.active, .footer-nav a:hover { color: var(--accent); transform: translateY(-1px); }
    .nav-ico { font-size: 1.1rem; }

    /* ---------- Responsive (single breakpoint set: 900 / 768 / 480) ---------- */
    @media (max-width: 900px) {
      .body-grid { grid-template-columns: 1fr !important; }
      .col-right { order: -1; }
      .promo-grid { grid-template-columns: repeat(2, 1fr) !important; }
      .blog-layout { grid-template-columns: 1fr !important; }
      .blog-sidebar { display: none; }
    }
    @media (max-width: 768px) {
      .game-section { grid-template-columns: repeat(4, 1fr) !important; }
      .promo-grid { grid-template-columns: 1fr !important; }
    }
    @media (max-width: 480px) {
      .game-section { grid-template-columns: repeat(3, 1fr) !important; }
      .col-right-actions a { padding: 10px !important; }
    }

    /* ---------- CTA buttons (pill) ---------- */
    .cta-btn {
      display: flex; align-items: center; justify-content: center;
      padding: 11px 10px; border-radius: 50px;
      font-size: .8rem; font-weight: 700; cursor: pointer;
      text-align: center; transition: opacity .2s, transform .15s; color: #fff;
      text-decoration: none; position: relative; overflow: hidden;
    }
    .cta-btn:hover { opacity: .88; transform: translateY(-1px); }
    .cta-btn-share    { background: #1a9c2a; }
    .cta-btn-downline { background: #1a3fcc; }
    .cta-btn-copy     { background: #cc1a1a; border: none; }
    .cta-btn-info     { background: #8a6d00; border: 1px solid var(--accent); }

    /* Signature: gold shimmer sweep on primary conversion buttons */
    .shimmer { position: relative; overflow: hidden; }
    .shimmer::after {
      content: ''; position: absolute; top: 0; left: -60%; width: 40%; height: 100%;
      background: linear-gradient(115deg, transparent, rgba(255,255,255,.55), transparent);
      transform: skewX(-20deg);
      animation: shimmer-sweep 3.2s ease-in-out infinite;
    }
    @keyframes shimmer-sweep {
      0%   { left: -60%; }
      35%  { left: 130%; }
      100% { left: 130%; }
    }

    /* Section surface used across pages */
    .surface {
      background: linear-gradient(180deg, rgba(26,26,46,.9), rgba(13,17,34,.9));
      border: 1px solid var(--line);
      border-radius: var(--radius);
      box-shadow: var(--shadow-gold);
    }

    /* Toast */
    #toast {
      display: none; position: fixed; bottom: 80px; left: 50%; transform: translateX(-50%);
      background: var(--accent); color: #000; padding: 10px 20px; border-radius: 20px;
      font-weight: 700; z-index: 9999; transition: opacity .3s; pointer-events: none;
      box-shadow: 0 8px 24px rgba(0,0,0,.45);
    }

    /* Shared blog listing styles — used by /blog/ index and /blog/category/[category]/.
       Kept here (not per-page) so every blog-listing page gets them automatically instead
       of relying on each page file to duplicate this block correctly. */
    .blog-layout { max-width: 1200px; margin: 0 auto; padding: var(--gap); padding-bottom: 80px; display: grid; grid-template-columns: 1fr 300px; gap: 28px; }
    .blog-heading { font-size: clamp(1.4rem, 3vw, 2rem); font-weight: 800; margin-bottom: 6px; }
    .blog-subheading { color: #9aa4c2; font-size: .9rem; margin-bottom: 24px; }
    .blog-back-link { display: inline-block; color: var(--accent); font-size: .85rem; font-weight: 700; margin-bottom: 12px; }

    .blog-cat-nav { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 24px; }
    .blog-cat-pill {
      padding: 6px 16px; border-radius: 20px; font-size: .8rem; font-weight: 700;
      border: 1px solid var(--accent); color: var(--accent); background: transparent;
      transition: background .15s, color .15s;
    }
    .blog-cat-pill:hover { background: rgba(245, 208, 67, .1); }
    .blog-cat-pill.active { background: var(--accent); color: #000; }

    .blog-featured { display: grid; grid-template-columns: repeat(3, 1fr); gap: 14px; margin-bottom: 32px; }
    .blog-card--featured .blog-card-img { aspect-ratio: 4/3; }

    .blog-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 16px; }

    .blog-card {
      display: block; background: var(--bg2); border-radius: var(--radius); overflow: hidden;
      border: 1px solid #2a2a2a; transition: transform .18s var(--ease-out), border-color .18s, box-shadow .18s;
    }
    .blog-card:hover { transform: translateY(-3px); border-color: var(--accent); box-shadow: var(--shadow-gold); }
    .blog-card-img { width: 100%; display: block; aspect-ratio: 16/9; object-fit: cover; }
    .blog-card-body { padding: 14px; }
    .blog-card-meta { display: flex; align-items: center; gap: 8px; margin-bottom: 8px; }
    .blog-tag { background: var(--accent); color: #000; padding: 2px 8px; border-radius: 10px; font-weight: 700; font-size: .68rem; text-transform: uppercase; letter-spacing: .04em; }
    .blog-date { color: #888; font-size: .75rem; }
    .blog-card-title { font-size: 1rem; margin-bottom: 8px; line-height: 1.4; }
    .blog-card-excerpt { font-size: .83rem; color: #aaa; margin-bottom: 12px; }
    .blog-read-more { color: var(--accent); font-size: .83rem; font-weight: 700; }

    .sidebar-widget { background: var(--bg2); border-radius: var(--radius); padding: 14px; margin-bottom: 16px; border: 1px solid #333; }
    .sidebar-widget h3 { margin-bottom: 10px; font-size: .9rem; color: var(--accent); }
    .sidebar-search { display: flex; gap: 6px; }
    .sidebar-search input { flex: 1; padding: 8px; background: var(--bg); color: var(--text); border: 1px solid #444; border-radius: var(--radius); font-size: .85rem; }
    .search-btn { padding: 8px 12px; background: var(--accent); color: #000; border-radius: var(--radius); font-weight: 700; font-size: .85rem; }
    .sidebar-post { display: flex; gap: 10px; margin-bottom: 12px; align-items: flex-start; }
    .sidebar-post:last-child { margin-bottom: 0; }
    .sidebar-post-img { width: 60px; height: 45px; object-fit: cover; border-radius: 6px; flex-shrink: 0; }
    .sidebar-post-title { font-size: .8rem; font-weight: 600; line-height: 1.3; margin-bottom: 3px; }
    .sidebar-post-date { font-size: .72rem; color: #888; }

    @media (max-width: 900px) {
      .blog-layout { grid-template-columns: 1fr; }
      .blog-sidebar { display: none; }
      .blog-featured { grid-template-columns: 1fr; }
    }
    @media (max-width: 600px) {
      .blog-grid { grid-template-columns: 1fr; }
    }
  </style>
</head>
<body>
  <!-- Sidebar overlay -->
  <div class="sidebar-overlay" id="sidebarOverlay"></div>
  <!-- Slide-in sidebar -->
  <nav class="sidebar" id="sidebar">
    <div class="sidebar-header">
      <img src={siteConfig.images.logo} alt={siteConfig.brand} />
      <button class="sidebar-close" aria-label="Close menu">✕</button>
    </div>
    <div class="sidebar-nav">
      <a href="/"><span>🏠</span> Home</a>
      <button class="sidebar-dropdown-toggle" id="gamesDropdownToggle" type="button">
        <span>🎮</span> Games <span class="dropdown-chevron">▾</span>
      </button>
      <div class="sidebar-submenu" id="gamesSubmenu">
        {siteConfig.images.tabs.map((tab) => (
          <a href={`/categories/${tab.id}/`}>{tab.label}</a>
        ))}
      </div>
      <a href="/promotion/"><span>🎁</span> Promotion</a>
      <a href="/blog/"><span>📝</span> Blog</a>
      <a href={siteConfig.cta} target="_blank" rel="noopener"><span>📋</span> History</a>
      <a href={siteConfig.cta} target="_blank" rel="noopener"><span>💳</span> Deposit</a>
      <a href={siteConfig.cta} target="_blank" rel="noopener"><span>💰</span> Withdraw</a>
      <a href={siteConfig.cta} target="_blank" rel="noopener"><span>⚙️</span> Settings</a>
    </div>
    <div class="sidebar-cta">
      <a href="/login/" class="btn-login-side">LOG IN</a>
      <a href="/register/" class="btn-register-side">REGISTER</a>
    </div>
  </nav>

  <!-- Sticky header -->
  <header class="site-header">
    <button class="header-hamburger" aria-label="Menu">☰</button>
    <div class="header-logo-wrap">
      <a href="/"><img src={siteConfig.images.logo} alt={siteConfig.brand} /></a>
    </div>
    <div class="header-btns">
      <a href="/login/" class="btn-login-hdr">LOGIN</a>
      <a href="/register/" class="btn-register-hdr">REGISTER</a>
    </div>
  </header>

  <!-- Announcement marquee bar -->
  <div class="announcement-bar"><div class="marquee-inner" id="marqueeText"></div></div>

  <slot />

  <div id="toast"></div>

  <!-- Footer (5-tab fixed bottom nav) -->
  <nav class="footer-nav">
    <a href="/"><span class="nav-ico">🏠</span>Home</a>
    <a href={siteConfig.cta} target="_blank" rel="noopener"><span class="nav-ico">📋</span>History</a>
    <a href="/promotion/"><span class="nav-ico">🎁</span>Promo</a>
    <a href="/blog/"><span class="nav-ico">📝</span>Blog</a>
    <a href={siteConfig.cta} target="_blank" rel="noopener"><span class="nav-ico">⚙️</span>Setting</a>
  </nav>

  <script define:vars={{ SITE: siteConfig }}>
    window.SITE = SITE;

    document.querySelector('.header-hamburger')?.addEventListener('click', () => {
      document.getElementById('sidebar').classList.add('open');
      document.getElementById('sidebarOverlay').classList.add('open');
    });
    document.querySelector('.sidebar-close')?.addEventListener('click', () => {
      document.getElementById('sidebar').classList.remove('open');
      document.getElementById('sidebarOverlay').classList.remove('open');
    });
    document.getElementById('sidebarOverlay')?.addEventListener('click', () => {
      document.getElementById('sidebar').classList.remove('open');
      document.getElementById('sidebarOverlay').classList.remove('open');
    });
    document.getElementById('gamesDropdownToggle')?.addEventListener('click', () => {
      document.getElementById('gamesDropdownToggle').classList.toggle('open');
      document.getElementById('gamesSubmenu').classList.toggle('open');
    });

    // Pattern 1 — Marquee
    function startMarquee() {
      const pool = [
        `${SITE.domain} Trusted Online Casino Singapore, Come Play Now!`,
        `${SITE.brand} - Play and Win Big, 24/7 Support, Quick Deposit & Withdraw!`,
        `Fast Turnaround for Your Cash, Endless Fun at ${SITE.brand}!`,
        `Best Bonuses at ${SITE.domain} Singapore Online Casino`,
        `Check Latest Promos at ${SITE.domain}`,
        `High Chances of Winning Right Here at ${SITE.brand}!`,
      ];
      const shuffle = a => { for (let i = a.length - 1; i > 0; i--) { const j = Math.floor(Math.random() * (i + 1)); [a[i], a[j]] = [a[j], a[i]]; } return a; };
      const sep = '   ✦   ';
      const chosen = shuffle([...pool]).slice(0, 3);
      const text = [...chosen, ...chosen].join(sep) + sep;
      const el = document.getElementById('marqueeText');
      if (!el) return;
      el.textContent = text;
      let pos = el.parentElement.offsetWidth;
      (function tick() {
        pos -= 0.6;
        if (pos < -el.scrollWidth / 2) pos = el.parentElement.offsetWidth;
        el.style.transform = `translateX(${pos}px)`;
        requestAnimationFrame(tick);
      })();
    }
    startMarquee();

    // Pattern 5 — Copy + Toast (shared globally)
    window.copyReferral = function (link) {
      navigator.clipboard.writeText(link).then(() => showToast('Referral link copied!'));
    };
    window.showToast = function (msg) {
      const t = document.getElementById('toast');
      if (!t) return;
      t.textContent = msg;
      t.style.display = 'block';
      t.style.opacity = '1';
      setTimeout(() => {
        t.style.opacity = '0';
        setTimeout(() => t.style.display = 'none', 300);
      }, 2000);
    };

    // Highlight active footer nav tab
    (function markActive() {
      const path = window.location.pathname.replace(/\/index\.html$/, '/');
      document.querySelectorAll('.footer-nav a[href]').forEach(a => {
        const href = a.getAttribute('href');
        if (href === '/' && path === '/') a.classList.add('active');
        else if (href !== '/' && href.startsWith('/') && path.startsWith(href)) a.classList.add('active');
      });
    })();
