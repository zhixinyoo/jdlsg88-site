---
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import { siteConfig } from '../../config/site';

export async function getStaticPaths() {
  const cats = await getCollection('categories', ({ data }) => !data.draft);
  return cats.map(cat => ({ params: { slug: cat.id }, props: { cat } }));
}

const { cat } = Astro.props;
const { Content } = await render(cat);
const { title, description, metaDescription, image, icon, ctaLabel } = cat.data;

const catId = cat.id;
const gameCards = siteConfig.images.gameCards[catId as keyof typeof siteConfig.images.gameCards] ?? [];
---

<Layout title={title} description={metaDescription ?? description} ogImage={image}>
  <div class="cat-layout">

    {image && (
      <div class="cat-hero">
        <img src={image} alt={title} class="cat-hero-img" />
        <div class="cat-hero-overlay">
          {icon && <img src={icon} alt={title} class="cat-icon" />}
          <h1>{title}</h1>
          <a href={siteConfig.cta} target="_blank" rel="noopener" class="cat-hero-cta shimmer">
            {ctaLabel} at {siteConfig.brand} →
          </a>
        </div>
      </div>
    )}

    <div class="cat-body">

      {gameCards.length > 0 && (
        <section class="cat-games">
          <h2 class="section-heading">Play {title}</h2>
          <div class="cat-game-grid">
            {gameCards.map(card => (
              <a href={siteConfig.cta} target="_blank" rel="noopener" class="cat-game-card">
                <img src={card.src} alt={card.label ?? title} loading="lazy" onerror="this.closest('a')?.remove()" />
              </a>
            ))}
          </div>
          <div class="cat-cta-row">
            <a href={siteConfig.cta} target="_blank" rel="noopener" class="cat-cta-btn">
              View All {title} →
            </a>
          </div>
        </section>
      )}

      <div class="post-content prose">
        <Content />
      </div>

    </div>
  </div>
</Layout>

<script define:vars={{ cta: siteConfig.cta, label: ctaLabel, brand: siteConfig.brand }}>
  document.querySelectorAll('.post-content p').forEach(p => {
    if (p.textContent.trim() === '[CTA_BUTTON]') {
      p.outerHTML = `
        <div class="inline-cta">
          <a href="${cta}" target="_blank" rel="noopener" class="inline-cta-btn shimmer">
            🎰 ${label} at ${brand}
          </a>
        </div>`;
    }
  });
</script>

<style is:global>
.prose { line-height: 1.9; font-size: 1rem; color: #ddd; }
.prose h2 { color: var(--accent); font-size: 1.35rem; font-weight: 700; margin: 48px 0 16px; padding-bottom: 10px; border-bottom: 1px solid #2a2a2a; }
.prose h3 { color: var(--accent); font-size: 1.1rem; font-weight: 600; margin: 36px 0 12px; }
.prose h4 { color: #fff; font-size: .95rem; font-weight: 600; margin: 28px 0 10px; }
.prose p { margin-bottom: 1.15em; }
.prose ul, .prose ol { padding-left: 22px; margin-bottom: 1.15em; }
.prose li { margin-bottom: 0.5em; line-height: 1.8; }
.prose strong { color: #fff; font-weight: 700; }
.prose a { color: var(--accent); text-decoration: underline; }
.prose a:hover { opacity: .8; }
.prose blockquote {
  border-left: 3px solid var(--accent); padding: 12px 16px;
  background: var(--bg2); border-radius: 0 var(--radius) var(--radius) 0;
  margin: 1.15em 0; font-style: italic; color: #ccc;
}
.prose details { background: var(--bg2); border: 1px solid #333; border-radius: var(--radius); padding: 12px 16px; margin-bottom: 1.15em; }
.prose summary { cursor: pointer; font-weight: 600; color: #fff; }
.prose summary:hover { color: var(--accent); }
.prose details[open] summary { color: var(--accent); margin-bottom: 10px; }
.prose table { width: 100%; border-collapse: collapse; margin-bottom: 1.15em; font-size: .85rem; }
.prose th { background: var(--accent); color: #000; padding: 10px 12px; text-align: left; font-weight: 700; }
.prose td { padding: 9px 12px; border-bottom: 1px solid #2a2a2a; }
.prose tr:nth-child(even) td { background: rgba(255,255,255,.03); }
.inline-cta { text-align: center; margin: 32px 0; }
.inline-cta-btn {
  display: inline-block; padding: 16px 36px; background: var(--accent); color: #000;
  font-weight: 800; font-size: 1.05rem; border-radius: var(--radius);
  box-shadow: 0 4px 20px rgba(0,0,0,.4); transition: transform .15s, opacity .15s;
  letter-spacing: .02em;
}
.inline-cta-btn:hover { transform: translateY(-2px); opacity: .9; }
/* .prose a { color: var(--accent) } outranks .inline-cta-btn on specificity alone —
   without this, the button text renders in the same gold as its own background. */
.prose a.inline-cta-btn { color: #000; text-decoration: none; }

.cat-layout { max-width: 1100px; margin: 0 auto; padding: var(--gap); padding-bottom: 80px; }

.cat-hero { position: relative; border-radius: var(--radius); overflow: hidden; margin-bottom: 32px; border: 1px solid var(--line); box-shadow: var(--shadow-lift); }
.cat-hero-img { width: 100%; max-height: 380px; object-fit: cover; display: block; }
.cat-hero-overlay {
  position: absolute; bottom: 0; left: 0; right: 0; padding: 24px 32px;
  background: linear-gradient(transparent, rgba(0,0,0,.88));
  display: flex; align-items: center; gap: 16px; flex-wrap: wrap;
}
.cat-icon { width: 52px; height: 52px; border-radius: 12px; object-fit: cover; flex-shrink: 0; border: 2px solid var(--accent); }
.cat-hero-overlay h1 { flex: 1; font-size: clamp(1.3rem, 3vw, 2rem); font-weight: 800; }
.cat-hero-cta {
  padding: 11px 22px; background: var(--accent); color: #000;
  font-weight: 700; border-radius: var(--radius); white-space: nowrap; font-size: .9rem;
  transition: opacity .2s;
}
.cat-hero-cta:hover { opacity: .85; }

.cat-body { display: flex; flex-direction: column; gap: 40px; }

.section-heading { color: var(--accent); font-size: 1.2rem; font-weight: 700; margin-bottom: 16px; }

.cat-game-grid {
  display: grid; grid-template-columns: repeat(auto-fill, minmax(120px, 1fr)); gap: 10px;
}
.cat-game-card {
  display: block; border-radius: 12px; overflow: hidden;
  aspect-ratio: 3/2; border: 1px solid #2a2a2a;
  transition: transform .15s, border-color .15s, box-shadow .15s;
}
.cat-game-card:hover { transform: translateY(-3px); border-color: var(--accent); box-shadow: 0 10px 24px rgba(0,0,0,.5); }
.cat-game-card img { width: 100%; height: 100%; object-fit: cover; display: block; }

.cat-cta-row { text-align: center; margin-top: 20px; }
.cat-cta-btn {
  display: inline-block; padding: 12px 28px; border: 2px solid var(--accent);
  color: var(--accent); font-weight: 700; border-radius: var(--radius);
  font-size: .9rem; transition: background .2s, color .2s;
}
.cat-cta-btn:hover { background: var(--accent); color: #000; }
</style>
