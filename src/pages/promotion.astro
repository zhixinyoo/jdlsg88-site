---
import Layout from '../layouts/Layout.astro';
import { siteConfig } from '../config/site';

const icons: Record<string, string> = {
  'Welcome Bonus': '🎉',
  'Free Credit': '💰',
  'Daily Rebate': '🔄',
  'VIP Cashback': '👑',
  'Referral Bonus': '🤝',
};
---

<Layout
  title={`Promotions & Bonuses - ${siteConfig.brand}`}
  description={`Claim exclusive bonuses and promotions at ${siteConfig.brand}. Welcome bonus, free credit, daily rebate and more available now.`}
>
  <div class="promo-page">
    <h1 class="promo-h1">{siteConfig.brand} Promotions &amp; Bonuses</h1>
    <p class="promo-sub">Real offers, real terms — no hidden wagering surprises.</p>

    <div class="promo-grid">
      {siteConfig.images.promoData.map(promo => (
        <div class="promo-card">
          {promo.badge && <span class={`promo-badge badge-${promo.badge.toLowerCase()}`}>{promo.badge}</span>}
          <div class="promo-icon">{icons[promo.title] ?? '🎰'}</div>
          <h2 class="promo-title">{promo.title}</h2>
          <p class="promo-desc">{promo.description}</p>
          <p class="promo-wagering">Wagering: <strong>{promo.wagering}</strong></p>
          <a href={siteConfig.cta} target="_blank" rel="noopener" class="promo-claim shimmer">CLAIM NOW</a>
        </div>
      ))}
    </div>

    <div class="promo-terms surface">
      <h3>General Bonus Terms</h3>
      <ul>
        <li>Minimum deposit of SGD 10 required to activate the Welcome Bonus.</li>
        <li>Wagering requirements must be met before bonus winnings become withdrawable.</li>
        <li>Daily Rebate and VIP Cashback are calculated on turnover with no minimum spend.</li>
        <li>{siteConfig.brand} reserves the right to update promotion terms at any time — check this page regularly.</li>
      </ul>
    </div>
  </div>
</Layout>

<style>
  .promo-page { max-width: 1200px; margin: 0 auto; padding: 12px 6px 40px; }
  .promo-h1 { font-size: clamp(1.4rem, 3vw, 2rem); font-weight: 800; margin-bottom: 6px; }
  .promo-sub { color: #9aa4c2; font-size: .9rem; margin-bottom: 24px; }

  .promo-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 14px;
    margin-bottom: 32px;
  }

  .promo-card {
    position: relative;
    background: linear-gradient(180deg, rgba(26,26,46,.95), rgba(13,17,34,.95));
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 22px 16px 18px;
    text-align: center;
    box-shadow: var(--shadow-gold);
    transition: transform .18s var(--ease-out), border-color .18s;
  }
  .promo-card:hover { transform: translateY(-4px); border-color: var(--accent); }

  .promo-badge {
    position: absolute; top: -10px; right: 12px;
    font-size: .62rem; font-weight: 800; padding: 3px 10px; border-radius: 20px;
    color: #000; letter-spacing: .03em;
  }
  .badge-hot { background: #ff4d4d; color: #fff; }
  .badge-new { background: #4ade80; }
  .badge-vip { background: var(--accent); }

  .promo-icon { font-size: 2.2rem; margin-bottom: 10px; }
  .promo-title { font-size: 1.05rem; font-weight: 800; margin-bottom: 8px; color: #fff; }
  .promo-desc { font-size: .82rem; color: #cbd2e6; margin-bottom: 10px; line-height: 1.5; min-height: 3.2em; }
  .promo-wagering { font-size: .74rem; color: #9aa4c2; margin-bottom: 14px; }
  .promo-wagering strong { color: var(--accent); }
  .promo-claim {
    display: block; width: 100%; padding: 10px 0; border-radius: var(--radius);
    background: var(--accent); color: #000; font-weight: 800; font-size: .82rem;
  }

  .promo-terms { padding: 20px 22px; }
  .promo-terms h3 { color: var(--accent); font-size: 1rem; margin-bottom: 12px; }
  .promo-terms ul { padding-left: 20px; }
  .promo-terms li { font-size: .84rem; color: #cbd2e6; margin-bottom: 8px; line-height: 1.6; }

  @media (max-width: 900px) {
    .promo-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 768px) {
    .promo-grid { grid-template-columns: 1fr; }
  }
</style>
